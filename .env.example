# Non-secret production shape. Store actual values in Railway/provider secrets.
LOKI_RUNTIME=local
PORT=8787
LOKI_PUBLIC_ORIGIN=https://api.example.com
LOKI_PUBLIC_API_ORIGIN=https://api.example.com
LOKI_PUBLIC_WEB_ORIGIN=https://play.example.com
LOKI_GAME_BASE_DOMAIN=games.example.com
# Base64-encoded 32-byte key used only for one-time CLI authorization grants.
LOKI_DEVICE_AUTH_KEY=
LOKI_GITHUB_APP_SLUG=
# GitHub App credentials are an all-or-none group. The private key is a
# base64-encoded PEM; never expose any of these values to browser code.
LOKI_GITHUB_APP_ID=
LOKI_GITHUB_PRIVATE_KEY=
LOKI_GITHUB_WEBHOOK_SECRET=

# Supabase Auth and Loki control-plane PostgreSQL.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require

# Base64-encode PEM values before adding multiline keys to Railway.
LOKI_SESSION_PRIVATE_KEY=BASE64_ENCODED_ED25519_PRIVATE_KEY
LOKI_SESSION_PUBLIC_KEY=BASE64_ENCODED_ED25519_PUBLIC_KEY
# Base64url-encoded 32-byte key for signed private-play invitations.
LOKI_PLAY_INVITE_KEY=
# Set these only to versions approved by human legal counsel.
LOKI_TERMS_VERSION=
LOKI_PRIVACY_VERSION=
LOKI_AUP_VERSION=

# Cloudflare R2 game release storage.
LOKI_R2_BUCKET=lokiplay-releases
LOKI_R2_ACCOUNT_ID=
LOKI_R2_ACCESS_KEY_ID=
LOKI_R2_SECRET_ACCESS_KEY=
# Distinct GetObject-only credentials used by the web hosting service.
LOKI_R2_READ_ACCESS_KEY_ID=
LOKI_R2_READ_SECRET_ACCESS_KEY=

# Railway-internal Nakama endpoint and the dedicated Nakama Supabase project.
LOKI_NAKAMA_ORIGIN=http://nakama.railway.internal:7350
LOKI_NAKAMA_SERVER_KEY=
LOKI_NAKAMA_HTTP_KEY=
NAKAMA_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER:5432/postgres?sslmode=require
NAKAMA_SESSION_ENCRYPTION_KEY=
NAKAMA_REFRESH_ENCRYPTION_KEY=
NAKAMA_CONSOLE_USERNAME=
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=

# Sentry application monitoring. Railway provides infrastructure logs/metrics.
SENTRY_DSN=https://PUBLIC_KEY@SENTRY_HOST/PROJECT_ID
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
